# Leave Stripe unset to keep checkout from collecting or charging a card.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site origin for Stripe success and cancel URLs. Example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Odoo JSON-RPC. All three are required or orders are not recorded.
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
